# Med.uz.ai production settings. Copy to deploy/.env on the server, fill every value, keep the file private
# (chmod 600). Never commit deploy/.env. Generate secrets on the server:
#   openssl rand -base64 32   → APP_SECRET_KEY
#   openssl rand -base64 24   → POSTGRES_PASSWORD, BACKUP_PASSPHRASE (store the passphrase OFF the server too:
#                                without it the backups cannot be decrypted)

# Public address (DNS A record → this server). Caddy gets the HTTPS certificate automatically.
DOMAIN=klinika.example.uz
ACME_EMAIL=admin@example.uz
# Public address of the server as the outside world reaches it: cameras push events to <PUBLIC_URL>/api/v1/hik/<token>,
# Telegram links point here. Leave empty for https://DOMAIN.
PUBLIC_URL=

POSTGRES_PASSWORD=
APP_SECRET_KEY=
# A session lives SESSION_TTL_HOURS after the last activity, but never longer than SESSION_MAX_HOURS after sign-in
# (a cashier's shift is not cut in the middle; a forgotten browser still expires)
SESSION_TTL_HOURS=12
SESSION_MAX_HOURS=14

# Backups (inside the server; copy BACKUP_DIR to a second location too — see docs/DEPLOY_UZ.md)
BACKUP_PASSPHRASE=
BACKUP_DIR=./backups
BACKUP_HOUR=02
KEEP_DAILY=14
KEEP_WEEKLY=8

# Telegram reminders, outbox and daily news run in the background
BACKGROUND_WORKERS=on

# AI: off until a paid key is configured. Gemini's free tier never receives clinical text of a real clinic.
# In production the clinical routes (note draft, ICD-10) stay refused (503 AI_DISABLED_PRODUCTION) until
# AI_CLINICAL_ALLOWED=1; specialty news works with AI_MODE=live alone. AI_DAILY_LIMIT_USD caps each clinic's spend per day.
AI_MODE=off
AI_CLINICAL_ALLOWED=0
AI_DAILY_LIMIT_USD=5
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
GEMINI_PAID=0
NEWS_ENABLED=on
NCBI_API_KEY=

# Doctor dictation (docs/VOICE_SCRIBE.md). local = the optional `stt` service on THIS server (start it with
# `--profile stt`): the recording never leaves the clinic's server and needs no AI_CLINICAL_ALLOWED. openai = OpenAI's
# cloud (OPENAI_API_KEY), refused for clinical audio until AI_CLINICAL_ALLOWED=1. off = the microphone buttons are hidden.
STT_PROVIDER=off
STT_BASE_URL=http://stt:8000
# Stock Whisper is good at Russian, weak at Uzbek: an Uzbek fine-tune (CTranslate2 format) for uz, large-v3 for ru.
STT_MODEL=Systran/faster-whisper-large-v3
STT_MODEL_UZ=
STT_MODEL_RU=
STT_API_KEY=
OPENAI_API_KEY=
STT_TIMEOUT_MS=120000
STT_RATE_PER_HOUR=30
STT_CPU_THREADS=4
STT_MEMORY=6g
# 1 after the models are downloaded: the speech server then never contacts the internet
STT_OFFLINE=0
