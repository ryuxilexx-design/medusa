# Med.uz.ai production settings. Copy to deploy/.env on the server, fill every value, keep the file private
# (chmod 600). Never commit deploy/.env. Generate secrets on the server:
#   openssl rand -base64 32   → APP_SECRET_KEY
#   openssl rand -base64 24   → POSTGRES_PASSWORD, BACKUP_PASSPHRASE (store the passphrase OFF the server too:
#                                without it the backups cannot be decrypted)

# Public address (DNS A record → this server). Caddy gets the HTTPS certificate automatically.
DOMAIN=klinika.example.uz
ACME_EMAIL=admin@example.uz

POSTGRES_PASSWORD=
APP_SECRET_KEY=
SESSION_TTL_HOURS=12

# Backups (inside the server; copy BACKUP_DIR to a second location too — see docs/DEPLOY_UZ.md)
BACKUP_PASSPHRASE=
BACKUP_DIR=./backups
BACKUP_HOUR=02
KEEP_DAILY=14
KEEP_WEEKLY=8

# Telegram reminders, outbox and daily news run in the background
BACKGROUND_WORKERS=on

# AI: off until a paid key is configured. Gemini's free tier never receives clinical text of a real clinic.
AI_MODE=off
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
GEMINI_API_KEY=
GEMINI_PAID=0
NEWS_ENABLED=on
NCBI_API_KEY=
