# --- Database (docker compose: 127.0.0.1:5433) ---
DATABASE_URL=postgres://meduza:meduza_local@127.0.0.1:5433/meduza

# --- API ---
API_PORT=4000
# development | demo | production. Demo login and reset work only in development/demo.
APP_MODE=demo
# Demo "today" (Asia/Tashkent local date).
DEMO_DATE=2026-10-18
# Optional HH:MM. If set, the demo clock starts at this time when the API starts and runs in real time.
# 11:30 keeps the seeded morning (arrivals/payments up to ~11:05) in the past and leaves the afternoon free
# for live bookings, whatever the real time of the meeting. Leave empty to use the real Tashkent time of day.
DEMO_TIME=11:30
# Session: extended by SESSION_TTL_HOURS on activity, never beyond SESSION_MAX_HOURS after sign-in
SESSION_TTL_HOURS=12
SESSION_MAX_HOURS=14

# Public address of this server (https://klinika.example.uz): cameras push events to it. Empty = taken from the request.
PUBLIC_URL=

# --- Secrets & Telegram bot ---
# 32 random bytes, base64. Encrypts stored secrets (Telegram bot tokens). Generate: openssl rand -base64 32
# Losing or changing it makes stored tokens unreadable (reconnect the bot). Never commit a real value.
APP_SECRET_KEY=
# Background workers: Telegram long polling, reminders, notification delivery, daily doctor news. on (default) | off
BACKGROUND_WORKERS=on

# --- AI (server-side only, never exposed to the browser) ---
# off | sample | live. Default: sample on a demo/dev server, off when APP_MODE=production.
AI_MODE=sample
# Fiscal receipts (ОФД): manual = parallel mode with the clinic's certified KKM (default in production), none = no fiscal receipts (default in demo).
# FISCAL_PROVIDER=manual
# anthropic (Claude) | gemini. Keys are needed only for AI_MODE=live. Leave them empty in the repository.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Note drafting and ICD-10 suggestions run on a mid-size model by default (cheaper than Opus; override if needed).
AI_MODEL=claude-sonnet-5-5
# APP_MODE=production refuses clinical routes (note draft, ICD-10) with 503 AI_DISABLED_PRODUCTION unless this is 1.
# Public routes (specialty news) are not affected. Switch it on only after the clinic's consent texts cover AI processing.
AI_CLINICAL_ALLOWED=0
# Per-clinic daily spend cap in USD (summed from ai_usage); a call over the cap answers 429 AI_BUDGET. 0 = no cap.
AI_DAILY_LIMIT_USD=5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# 1 = paid Gemini tier. On the free tier Google may use prompts to improve its products, so note drafting and ICD-10
# suggestions go there only for the seed demo clinics outside APP_MODE=production (news of public articles always works).
GEMINI_PAID=0
# Only for tests/proxies (Claude uses AI_BASE_URL); empty = Google's API.
GEMINI_BASE_URL=
AI_TIMEOUT_MS=20000

# --- Daily specialty news for doctors (PubMed + AI summary in Uzbek) ---
# off disables fetching. Without AI (AI_MODE≠live) only the original title and link are shown.
NEWS_ENABLED=on
# Optional NCBI E-utilities key (raises the PubMed rate limit). https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=

# --- Web ---
# Where the Next.js server proxies /api/v1 requests
API_INTERNAL_URL=http://127.0.0.1:4000
